# Drs-Zona environment settings
#
# Copy this file to .env in the repository root:  cp .env.example .env
# The API, `dotnet ef` and the tests find it from any folder of the repo.
# To keep the file somewhere else, set ENV_FILE to its path in your shell or
# systemd unit (not in this file):  ENV_FILE=~/.config/drs-zona/.env
# Variables already set in the environment win over this file.
# Never commit .env.

# =========================
# Ports (local dev only, prod ignores them)
# =========================
# All optional. Leave them commented out to keep today's ports.
#
# Angular dev server (pnpm start), default 4200
# FRONTEND_PORT=4200
# API over HTTP (dotnet run; dev proxy for /uploads; pnpm open-api-gen), default 5244
# API_PORT=5244
# API over HTTPS (dotnet run --launch-profile https; dev proxy for /api), default 7221
# API_HTTPS_PORT=7221

# =========================
# Database (read by the API and `dotnet ef`)
# =========================
# Required
DB_HOST=localhost
DB_NAME=drs_zona
DB_USER=postgres
DB_PASSWORD=your_password_here
# Optional, default 5432
DB_PORT=5432

# =========================
# JWT (read by the API)
# =========================
# Required, at least 32 characters. 
JWT_SECRET=change_to_a_random_string_of_at_least_32_chars
# Optional, default MotorsportSocialNetwork
JWT_ISSUER=drs-zona-api
# Optional, default MotorsportSocialNetworkUsers
JWT_AUDIENCE=drs-zona-client
# Optional, default 1440 (24 hours)
JWT_EXPIRATION_MINUTES=60

# =========================
# CORS (read by the API)
# =========================
# Optional, comma-separated, default http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# =========================
# Uploads (read by the API)
# =========================
# Optional. Default: uploads/ in the API's content root
# (server/API/uploads with dotnet run).
# A relative path starts from the content root.
# UPLOADS_PATH=/home/<your-name>/Drs-Zona-data/uploads
